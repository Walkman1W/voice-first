{
  "name": "crayfish-voice-desktop",
  "version": "2.0.0",
  "description": "小龙虾语音助手 - 桌面版",
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "npm run build && python3 backend/main.py",
    "start:legacy": "node server.js",
    "backend": "python3 backend/main.py",
    "dev": "vite",
    "build": "tsc && vite build && npm run copy:vad",
    "copy:vad": "node scripts/copy-vad-assets.js",
    "postinstall": "node scripts/copy-vad-assets.js",
    "electron:dev": "vite --mode electron",
    "electron:build": "vite build && electron-builder",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=crayfish-voice",
    "tunnel": "cloudflared tunnel run crayfish-backend",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.30",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "onnxruntime-web": "^1.26.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "optionalDependencies": {
    "electron": "^31.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  }
}
