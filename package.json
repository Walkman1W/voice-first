{
  "name": "crayfish-voice-desktop",
  "version": "2.0.0",
  "description": "小龙虾语音助手 - 桌面版",
  "main": "dist-electron/main.js",
  "author": "Crayfish Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"npm run electron:dev\"",
    "electron:dev": "tsc -p electron/tsconfig.json && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron dist-electron/main.js",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "package": "npm run build && npm run build:electron && electron-builder",
    "package:dir": "npm run build && npm run build:electron && electron-builder --dir",
    "backend": "python3 backend/main.py",
    "start": "npm run build && npm run build:electron && electron dist-electron/main.js",
    "start:web": "npm run build && python3 backend/main.py",
    "postinstall": "node scripts/copy-vad-assets.js",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.30",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "onnxruntime-web": "^1.26.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  },
  "build": {
    "appId": "com.crayfish.voice-assistant",
    "productName": "小龙虾语音助手",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "backend/**/*",
      "!backend/__pycache__/**",
      "!backend/models/**"
    ],
    "extraResources": [
      {
        "from": "backend/models",
        "to": "models",
        "filter": ["**/*"]
      }
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "mac": {
      "target": ["dmg"]
    }
  }
}
