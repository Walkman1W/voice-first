# 小龙虾语音助手 - 环境变量配置

# ===== 后端配置 =====
PORT=8765
HOST=0.0.0.0
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=your_gateway_token_here
TTS_VOICE=zh-CN-XiaoxiaoNeural
ASR_ENGINE=edge

# 火山引擎 ASR 后端代理配置（header 鉴权，浏览器无法直连）
VOLCANO_ASR_APP_KEY=your_app_key_here
VOLCANO_ASR_ACCESS_KEY=0009ff60-ee81-49c2-b4de-a2d73cf0ff78
VOLCANO_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
VOLCANO_ASR_RESOURCE_ID=volc.bigasr.sauc.duration

# DeepSeek v4 Flash - LLM 意图分类器（语义判断模块）
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_MODEL=deepseek-chat

# 交互模式: work(关键词/语义触发发送) | chat(静默自动发送)
INTERACTION_MODE=work
# 聊天模式下静默超时秒数
SILENCE_TIMEOUT_S=5

# ===== 前端配置 (Vite 环境变量，VITE_ 前缀) =====

# WebSocket 后端端口（如果前后端分离开发时需要）
# VITE_WS_PORT=8765
# WebSocket 后端完整 URL（部署时使用，优先级高于 VITE_WS_PORT）
# VITE_WS_URL=wss://api-siri.agentsignals.ai/ws

# ASR 引擎选择: 'volcano' | 'webspeech'
VITE_ASR_ENGINE=volcano

# 火山引擎前端配置（用于构建 ASR 配置帧）
VITE_VOLCANO_ASR_APP_ID=default
VITE_VOLCANO_ASR_TOKEN=0009ff60-ee81-49c2-b4de-a2d73cf0ff78
VITE_VOLCANO_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
VITE_VOLCANO_ASR_CLUSTER=volcengine_streaming_common
VITE_VOLCANO_ASR_UID=crayfish-user

# VAD 配置
VITE_VAD_ASSET_PATH=/vad/
VITE_VAD_MODEL=v5
VITE_VAD_POSITIVE_THRESHOLD=0.7
VITE_VAD_NEGATIVE_THRESHOLD=0.3
VITE_VAD_MIN_SPEECH_MS=250
# 后静默延迟（检测到静默后等待多久触发发送，默认1000ms，越低越灵敏）
VITE_VAD_REDEMPTION_MS=1000

# 其他
VITE_SPEECH_LANGUAGE=zh-CN
VITE_PLAYBACK_RESUME_DELAY_MS=2000
VITE_MAX_LOG_ENTRIES=80
